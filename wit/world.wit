package component:googleappsscript-in-rust-example;

world my-world {
	// WASI Proposals (Google Apps Script の V8 同期環境で実装・再現可能なインターフェース)
	// ※ WIT定義は wit/deps/wasi-* 内の公式 WASI プロポーザル (0.3.2) に準拠しています。
	// ※ 非同期ストリーム (stream<T> / future<T> / async func) を要求するインターフェースや、
	//    GAS 上で再現不可能な機能 (wasi:filesystem, wasi:sockets, wasi:http, wasi:cli/stdio@0.3.2 等) は
	//    js/wasi-*.ts 側で呼び出し時に WasiNotImplementedError を送出し、未実装であることが明確に判別できます。
	// ※ Rust 標準の println! / eprintln! や std::time::Instant は wasm32-wasip2 ターゲットがリンクする
	//    WASI 0.2 インポート経由で Makefile の --map により js/wasi-cli.ts・js/wasi-io.ts・js/wasi-monotonic-clock.ts に接続されます。
	import wasi:logging/logging@0.1.0-draft;
	import wasi:random/random@0.3.2;
	import wasi:random/insecure@0.3.2;
	import wasi:random/insecure-seed@0.3.2;
	import wasi:clocks/types@0.3.2;
	import wasi:clocks/system-clock@0.3.2;
	import wasi:clocks/timezone@0.3.2;
	import wasi:cli/environment@0.3.2;
	import wasi:cli/exit@0.3.2;
	import wasi:cli/terminal-input@0.3.2;
	import wasi:cli/terminal-output@0.3.2;
	import wasi:cli/terminal-stdin@0.3.2;
	import wasi:cli/terminal-stdout@0.3.2;
	import wasi:cli/terminal-stderr@0.3.2;

	import example:resouceex/example-resource;

	// Google Apps Script APIs
	import gas:logger/logger@0.1.0-alpha;
	import gas:drive-app/gas-drive-app@0.1.0-alpha;
	import gas:property/properties-service@0.1.0-alpha;
	import gas:spreadsheet-app/gas-spreadsheet-app@0.1.0-alpha;

	import gas:content-service/gas-content-service@0.1.0-alpha;
	use gas:content-service/gas-text-output@0.1.0-alpha.{gas-text-output};

	import gas:math/gas-math@0.1.0-alpha;
	import gas:urlfetchapp/gas-url-fetch-app@0.1.0-alpha;

	import gas:utilities/gas-utilities@0.1.0-alpha;

	import gas:html-service/gas-html-service@0.1.0-alpha;
	use gas:html-service/gas-html-output@0.1.0-alpha.{gas-html-output};

	import gas:cache-service/gas-cache-service@0.1.0-alpha;
	import gas:lock-service/gas-lock-service@0.1.0-alpha;
	import gas:session/gas-session@0.1.0-alpha;
	import gas:mail-app/gas-mail-app@0.1.0-alpha;
	import gas:gmail-app/gas-gmail-app@0.1.0-alpha;
	import gas:calendar-app/gas-calendar-app@0.1.0-alpha;
	import gas:document-app/gas-document-app@0.1.0-alpha;
	import gas:script-app/gas-script-app@0.1.0-alpha;

	variant cell-value {
		empty,
		string-value(string),
	}

	variant web-response {
		text(gas-text-output),
		html(gas-html-output),
	}

	// web (doGet / doPost, Git Smart HTTP v1 endpoints, and Web UI APIs)
	export rs-do-get: func(data: string) -> web-response;
	export rs-do-post: func(data: string) -> gas-text-output;
	export git-init-repo: func(repo: option<string>) -> string;
	export git-list-repos: func() -> string;
	export git-create-repo: func(repo: string, description: option<string>) -> string;
	export git-get-commits: func(repo: string) -> string;

	export variant-func00: func() -> cell-value;

	export scream: func(input: string) -> string;
	export say-hello: func(input: string);
	export resource-example: func();
	export helloworld-example: func();
	export get-script-properties-example: func();
	export spreadsheet-example: func();
	export http-request-test: func();
	export utilities-example: func();
	export html-service-example: func() -> gas-html-output;
	export wasi-showcase-example: func();
}
