#!/usr/bin/env python3
"""
git-remote-gas: High-performance Git remote helper for Google Apps Script (GAS) Web Apps.

Supports GitHub-style repository URLs (without username):
  git remote add origin gas::https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec/project_name.git
  git clone gas::https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec/project_name.git

Key Features & Optimizations:
1. URL path parsing: extracts the GAS `/exec` (or `/dev`) endpoint and the `/<project_name>.git`
   repository path, forwarding `/<project_name>.git/info/refs`, `/<project_name>.git/git-upload-pack`,
   and `/<project_name>.git/git-receive-pack` cleanly.
2. Empty repository (0-commit) advertisement (`0000... capabilities^{}`) so newly created
   repositories can receive their initial `git push -u origin main` from the client.
3. Persistent HTTP/1.1 Keep-Alive connection pool (`http.client.HTTPSConnection` / `HTTPConnection`
   with `TCP_NODELAY`) across `script.google.com` and `script.googleusercontent.com` redirects,
   eliminating repeated TLS handshake overhead.
4. Smart HTTP v1-compliant Adaptive Multi-Chunk Push (`git-receive-pack`) for large repositories
   (such as `gleam`):
   - Partitions large pushes into self-contained `PACK` v2 chunks (`--delta-base-offset`, no external
     `REF_DELTA` dependencies) bounded by uncompressed object size (`GAS_GIT_CHUNK_UNCOMPRESSED_MB`,
     default 12 MB), object count (`GAS_GIT_CHUNK_OBJECTS`, default 2,500), and compressed pack size
     (`GAS_GIT_CHUNK_PACK_MB`, default 5 MB).
   - Advances the remote branch along first-parent commit checkpoints so interrupted pushes of
     large repositories automatically resume from the last completed checkpoint.
   - Pipelines `git pack-objects` + Base64 encoding of Chunk `i+1` in a background worker thread
     while Chunk `i` is in flight over HTTP.
   - Automatically splits a chunk in half and retries if GAS reports a memory or payload limit error.
5. Step-by-step authentication fallback (env token/cookie, anonymous, cached credentials,
   `~/.clasprc.json` OAuth auto-refresh, and interactive login prompt).
"""

import base64
import concurrent.futures
import http.client
import http.cookiejar
import json
import os
import re
import socket
import ssl
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple


AUTH_CACHE_PATH = Path.home() / ".config" / "git-remote-gas" / "auth.json"
CLASPRC_PATH = Path.home() / ".clasprc.json"

VALID_PROJECT_RE = re.compile(r"^[A-Za-z0-9._-]+$")

DEFAULT_MAX_CHUNK_OBJECTS = 2500
DEFAULT_MAX_CHUNK_UNCOMPRESSED_BYTES = 12 * 1024 * 1024  # 12 MB uncompressed per chunk
DEFAULT_MAX_CHUNK_PACK_BYTES = 5 * 1024 * 1024           # 5 MB compressed pack per chunk
DEFAULT_MAX_CHUNK_COMMITS = 400


def log_err(msg: str) -> None:
    sys.stderr.write(f"[git-remote-gas] {msg}\n")
    sys.stderr.flush()


def get_gas_git_timeout() -> Optional[float]:
    """
    Returns HTTP request timeout in seconds.
    Configurable via environment variable `GAS_GIT_TIMEOUT` (default: 300 seconds / 5 minutes).
    Set `GAS_GIT_TIMEOUT=0` or negative to disable timeout entirely.
    """
    raw = os.environ.get("GAS_GIT_TIMEOUT", "").strip()
    if raw:
        try:
            val = float(raw)
            return None if val <= 0 else val
        except ValueError:
            pass
    return 300.0


def get_chunk_limits() -> Tuple[int, int, int, int]:
    """
    Returns `(max_objects, max_uncompressed_bytes, max_pack_bytes, max_commits)` per push chunk.
    Configurable via environment variables:
      - `GAS_GIT_CHUNK_OBJECTS` (default: 2500)
      - `GAS_GIT_CHUNK_UNCOMPRESSED_BYTES` or `GAS_GIT_CHUNK_UNCOMPRESSED_MB` (default: 12 MB)
      - `GAS_GIT_CHUNK_PACK_BYTES` or `GAS_GIT_CHUNK_PACK_MB` (default: 5 MB)
      - `GAS_GIT_CHUNK_COMMITS` (default: 400)
    """
    max_objs = DEFAULT_MAX_CHUNK_OBJECTS
    raw_objs = os.environ.get("GAS_GIT_CHUNK_OBJECTS", "").strip()
    if raw_objs:
        try:
            max_objs = max(1, int(raw_objs))
        except ValueError:
            pass

    max_uncomp = DEFAULT_MAX_CHUNK_UNCOMPRESSED_BYTES
    raw_uncomp_b = os.environ.get("GAS_GIT_CHUNK_UNCOMPRESSED_BYTES", "").strip()
    raw_uncomp_mb = os.environ.get("GAS_GIT_CHUNK_UNCOMPRESSED_MB", "").strip()
    if raw_uncomp_b:
        try:
            max_uncomp = max(65536, int(raw_uncomp_b))
        except ValueError:
            pass
    elif raw_uncomp_mb:
        try:
            max_uncomp = max(65536, int(float(raw_uncomp_mb) * 1024 * 1024))
        except ValueError:
            pass

    max_pack = DEFAULT_MAX_CHUNK_PACK_BYTES
    raw_pack_b = os.environ.get("GAS_GIT_CHUNK_PACK_BYTES", "").strip()
    raw_pack_mb = os.environ.get("GAS_GIT_CHUNK_PACK_MB", "").strip()
    if raw_pack_b:
        try:
            max_pack = max(32768, int(raw_pack_b))
        except ValueError:
            pass
    elif raw_pack_mb:
        try:
            max_pack = max(32768, int(float(raw_pack_mb) * 1024 * 1024))
        except ValueError:
            pass

    max_commits = DEFAULT_MAX_CHUNK_COMMITS
    raw_commits = os.environ.get("GAS_GIT_CHUNK_COMMITS", "").strip()
    if raw_commits:
        try:
            max_commits = max(1, int(raw_commits))
        except ValueError:
            pass

    return max_objs, max_uncomp, max_pack, max_commits


def parse_gas_remote_url(raw_url: str) -> Tuple[str, str, str]:
    """
    Parse a GAS Git remote URL of the form:
      https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec/<project_name>.git

    Returns `(endpoint_url, project_name, repo_path)` where:
      - `endpoint_url`: `https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec`
      - `project_name`: `<project_name>` (without `.git`)
      - `repo_path`: `/<project_name>.git`
    """
    cleaned = raw_url.strip()
    if cleaned.startswith("gas::"):
        cleaned = cleaned[len("gas::") :]

    parsed = urllib.parse.urlparse(cleaned)
    if not parsed.scheme or not parsed.netloc:
        raise ValueError(
            f"Invalid GAS remote URL '{raw_url}'. Expected: "
            "gas::https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec/<project_name>.git"
        )

    segments = [seg for seg in parsed.path.split("/") if seg]

    # Locate `/exec` or `/dev` boundary in the URL path
    exec_idx: Optional[int] = None
    for idx, seg in enumerate(segments):
        if seg in ("exec", "dev"):
            exec_idx = idx
            break

    if exec_idx is not None:
        base_segments = segments[: exec_idx + 1]
        after_exec = segments[exec_idx + 1 :]
    else:
        # Fallback if custom reverse-proxy URL without `/exec` is used: last segment is `<project_name>.git`
        if len(segments) >= 1 and segments[-1].endswith(".git"):
            base_segments = segments[:-1]
            after_exec = [segments[-1]]
        else:
            after_exec = []
            base_segments = segments

    if len(after_exec) != 1:
        raise ValueError(
            f"Repository name missing or invalid in URL '{raw_url}'. "
            "Specify the project name at the end of the URL like GitHub:\n"
            "  gas::https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec/project_name.git"
        )

    raw_repo_seg = after_exec[0].strip()
    project_name = raw_repo_seg[:-4] if raw_repo_seg.endswith(".git") else raw_repo_seg
    if (
        not project_name
        or project_name in (".", "..")
        or not VALID_PROJECT_RE.match(project_name)
    ):
        raise ValueError(f"Invalid project name '{raw_repo_seg}' in URL '{raw_url}'.")

    repo_path = f"/{project_name}.git"
    endpoint_path = "/" + "/".join(base_segments)
    endpoint_url = urllib.parse.urlunparse(
        (parsed.scheme, parsed.netloc, endpoint_path, parsed.params, parsed.query, "")
    )
    return endpoint_url, project_name, repo_path


def normalize_gas_url(
    endpoint_url: str,
    repo_path: str,
    sub_path: str,
    query_params: Dict[str, str],
) -> str:
    """
    Preserve the `/exec` (or `/dev`) endpoint and pass the full Git path
    `/<project_name>.git/<sub_path>` via `git_path` so GAS routes the request to `doGet`/`doPost`.
    """
    parsed = urllib.parse.urlparse(endpoint_url)
    existing_qs = dict(urllib.parse.parse_qsl(parsed.query, keep_blank_values=True))
    clean_sub = sub_path.lstrip("/")
    existing_qs["git_path"] = f"{repo_path}/{clean_sub}" if clean_sub else repo_path
    existing_qs.update(query_params)
    new_query = urllib.parse.urlencode(existing_qs)
    return urllib.parse.urlunparse(
        (parsed.scheme, parsed.netloc, parsed.path, parsed.params, new_query, "")
    )


class KeepAliveHttpPool:
    """
    Persistent HTTP/1.1 Keep-Alive connection pool with TCP_NODELAY.
    Eliminates repeated TCP + TLS handshakes across multi-chunk pushes and 302 redirects.
    """

    def __init__(self) -> None:
        self._conns: Dict[Tuple[str, str, int], http.client.HTTPConnection] = {}
        self._ssl_ctx = ssl.create_default_context()

    def _get_conn(
        self, scheme: str, host: str, port: int, timeout: Optional[float]
    ) -> http.client.HTTPConnection:
        key = (scheme, host, port)
        conn = self._conns.get(key)
        if conn is not None:
            conn.timeout = timeout
            return conn
        if scheme == "https":
            conn = http.client.HTTPSConnection(
                host, port, timeout=timeout, context=self._ssl_ctx
            )
        else:
            conn = http.client.HTTPConnection(host, port, timeout=timeout)
        self._conns[key] = conn
        return conn

    def _drop_conn(self, scheme: str, host: str, port: int) -> None:
        key = (scheme, host, port)
        conn = self._conns.pop(key, None)
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass

    def request(
        self,
        url: str,
        method: str,
        headers: Dict[str, str],
        body: Optional[bytes],
        timeout: Optional[float],
    ) -> Tuple[int, str, Dict[str, str], bytes]:
        parsed = urllib.parse.urlparse(url)
        scheme = parsed.scheme.lower()
        host = parsed.hostname or ""
        port = parsed.port or (443 if scheme == "https" else 80)
        path_and_query = parsed.path or "/"
        if parsed.query:
            path_and_query = f"{path_and_query}?{parsed.query}"

        req_headers = dict(headers)
        req_headers["Connection"] = "keep-alive"
        if body is not None:
            req_headers["Content-Length"] = str(len(body))

        for attempt in range(2):
            conn = self._get_conn(scheme, host, port, timeout)
            try:
                conn.request(method, path_and_query, body=body, headers=req_headers)
                if conn.sock is not None:
                    try:
                        conn.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
                    except OSError:
                        pass
                resp = conn.getresponse()
                raw = resp.read()
                resp_headers = {k: v for k, v in resp.getheaders()}
                for k, v in resp.getheaders():
                    if k.lower() == "location":
                        resp_headers["Location"] = v
                if resp.will_close:
                    self._drop_conn(scheme, host, port)
                return resp.status, resp.reason, resp_headers, raw
            except (
                http.client.RemoteDisconnected,
                http.client.CannotSendRequest,
                http.client.BadStatusLine,
                BrokenPipeError,
                ConnectionResetError,
            ):
                self._drop_conn(scheme, host, port)
                if attempt == 1:
                    raise
            except Exception:
                self._drop_conn(scheme, host, port)
                raise

        raise RuntimeError(f"Failed HTTP request to {url}")


class GasAuthManager:
    """Manages OAuth tokens, cookies, and interactive browser login fallback."""

    def __init__(self, remote_url: str):
        self.remote_url = remote_url
        self.cookie_jar = http.cookiejar.CookieJar()

    def get_env_auth_headers(self) -> Dict[str, str]:
        headers: Dict[str, str] = {}
        token = os.environ.get("GAS_GIT_TOKEN", "").strip()
        cookie = os.environ.get("GAS_GIT_COOKIE", "").strip()
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if cookie:
            headers["Cookie"] = cookie
        return headers

    def load_cached_auth(self) -> Dict[str, str]:
        if not AUTH_CACHE_PATH.exists():
            return {}
        try:
            data = json.loads(AUTH_CACHE_PATH.read_text(encoding="utf-8"))
            headers: Dict[str, str] = {}
            if data.get("token"):
                headers["Authorization"] = f"Bearer {data['token']}"
            if data.get("cookie"):
                headers["Cookie"] = data["cookie"]
            return headers
        except Exception:
            return {}

    def save_cached_auth(self, token: Optional[str] = None, cookie: Optional[str] = None) -> None:
        AUTH_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        data = {}
        if AUTH_CACHE_PATH.exists():
            try:
                data = json.loads(AUTH_CACHE_PATH.read_text(encoding="utf-8"))
            except Exception:
                data = {}
        if token is not None:
            data["token"] = token
        if cookie is not None:
            data["cookie"] = cookie
        AUTH_CACHE_PATH.write_text(json.dumps(data, indent=2), encoding="utf-8")
        try:
            os.chmod(AUTH_CACHE_PATH, 0o600)
        except OSError:
            pass

    def get_clasp_bearer_token(self) -> Optional[str]:
        """Reads ~/.clasprc.json and refreshes the access_token if expired."""
        if not CLASPRC_PATH.exists():
            return None
        try:
            raw = json.loads(CLASPRC_PATH.read_text(encoding="utf-8"))
            token_obj = raw.get("token") or raw.get("tokens", {}).get("default") or raw
            access_token = token_obj.get("access_token")
            refresh_token = token_obj.get("refresh_token")
            expiry_date = token_obj.get("expiry_date", 0)
            client_id = token_obj.get("client_id") or raw.get("oauth2ClientSettings", {}).get("clientId")
            client_secret = token_obj.get("client_secret") or raw.get("oauth2ClientSettings", {}).get("clientSecret")

            now_ms = int(time.time() * 1000)
            if refresh_token and client_id and client_secret and (not access_token or now_ms >= expiry_date - 60_000):
                refreshed = self._refresh_oauth_token(client_id, client_secret, refresh_token)
                if refreshed:
                    return refreshed
            return access_token
        except Exception:
            return None

    def _refresh_oauth_token(self, client_id: str, client_secret: str, refresh_token: str) -> Optional[str]:
        body = urllib.parse.urlencode(
            {
                "client_id": client_id,
                "client_secret": client_secret,
                "refresh_token": refresh_token,
                "grant_type": "refresh_token",
            }
        ).encode("utf-8")
        req = urllib.request.Request(
            "https://oauth2.googleapis.com/token",
            data=body,
            headers={"Content-Type": "application/x-www-form-urlencoded"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
                return payload.get("access_token")
        except Exception:
            return None

    def prompt_browser_login(self, target_url: str) -> Optional[Dict[str, str]]:
        """
        Opens the browser or prompts the user when GAS returns 404/401/403 or
        redirects to accounts.google.com.
        """
        log_err("============================================================")
        log_err("Google Apps Script Web App へのアクセス認証が必要です。")
        log_err(f"対象 URL: {target_url}")
        log_err("------------------------------------------------------------")
        log_err("【原因として考えられること】")
        log_err("  1. Webアプリのアクセス権限が「自分のみ」等になっており認証が必要")
        log_err("  2. ブラウザで未承認の初回実行、またはデプロイIDの不一致")
        log_err("============================================================")

        try:
            tty_in = open("/dev/tty", "r", encoding="utf-8")
            tty_out = open("/dev/tty", "w", encoding="utf-8")
        except OSError:
            log_err("非対話環境のためプロンプトを表示できません。")
            log_err("ブラウザで上記URLを開いて動作確認するか、GAS_GIT_TOKEN / GAS_GIT_COOKIE を設定してください。")
            return None

        with tty_in, tty_out:
            tty_out.write(
                "\n認証方法を選択してください:\n"
                "  [1] ブラウザで URL を開いて確認・ログインする (推奨)\n"
                "  [2] gcloud / clasp で OAuth アクセストークンを取得する\n"
                "  [3] ブラウザの Cookie (SID=...) または Bearer トークンを手動入力する\n"
                "  [q] 中止\n"
                "選択 [1/2/3/q] (デフォルト: 1): "
            )
            tty_out.flush()
            choice = tty_in.readline().strip() or "1"

            if choice == "q":
                return None

            if choice == "1":
                tty_out.write(f"\nブラウザで {target_url} を開いています...\n")
                tty_out.flush()
                webbrowser.open(target_url)
                tty_out.write(
                    "\n1. ブラウザでログイン・権限承認を行い、ページが表示されることを確認してください。\n"
                    "2. もしデプロイ設定が「全員 (Anyone)」であれば、そのまま Enter を押すと再試行します。\n"
                    "3. 「自分のみ (Only myself)」の場合は、ブラウザの開発者ツール (Networkタブ) から\n"
                    "   Cookie ヘッダー値 (または Bearer トークン) を貼り付けて Enter を押してください:\n"
                    "入力 (空のまま Enter で匿名再試行): "
                )
                tty_out.flush()
                user_val = tty_in.readline().strip()
                if not user_val:
                    return {}
                if "=" in user_val and not user_val.lower().startswith("bearer "):
                    self.save_cached_auth(cookie=user_val)
                    return {"Cookie": user_val}
                token = user_val.removeprefix("Bearer ").removeprefix("bearer ").strip()
                self.save_cached_auth(token=token)
                return {"Authorization": f"Bearer {token}"}

            if choice == "2":
                tty_out.write("\n`gcloud auth application-default login` または `clasp login` を実行します...\n")
                tty_out.flush()
                try:
                    proc = subprocess.run(
                        ["gcloud", "auth", "print-access-token"],
                        capture_output=True,
                        text=True,
                        check=False,
                    )
                    if proc.returncode == 0 and proc.stdout.strip():
                        token = proc.stdout.strip()
                        self.save_cached_auth(token=token)
                        return {"Authorization": f"Bearer {token}"}
                except FileNotFoundError:
                    pass

                subprocess.run(["pnpm", "exec", "clasp", "login"], check=False)
                token = self.get_clasp_bearer_token()
                if token:
                    self.save_cached_auth(token=token)
                    return {"Authorization": f"Bearer {token}"}
                return None

            if choice == "3":
                tty_out.write("\nCookie 文字列 (例: SID=...) または Bearer トークンを入力してください: ")
                tty_out.flush()
                user_val = tty_in.readline().strip()
                if not user_val:
                    return None
                if "=" in user_val and not user_val.lower().startswith("bearer "):
                    self.save_cached_auth(cookie=user_val)
                    return {"Cookie": user_val}
                token = user_val.removeprefix("Bearer ").removeprefix("bearer ").strip()
                self.save_cached_auth(token=token)
                return {"Authorization": f"Bearer {token}"}

        return None


class GasHttpClient:
    def __init__(self, raw_url: str):
        endpoint_url, project_name, repo_path = parse_gas_remote_url(raw_url)
        self.endpoint_url = endpoint_url.rstrip("/")
        self.project_name = project_name
        self.repo_path = repo_path
        self.auth = GasAuthManager(self.endpoint_url)
        self.pool = KeepAliveHttpPool()
        self._working_auth_headers: Optional[Dict[str, str]] = None

    def full_git_path(self, sub_path: str) -> str:
        clean_sub = sub_path.lstrip("/")
        return f"{self.repo_path}/{clean_sub}" if clean_sub else self.repo_path

    def request(
        self,
        method: str,
        sub_path: str,
        query_params: Dict[str, str],
        body: Optional[bytes] = None,
        content_type: Optional[str] = None,
    ) -> bytes:
        url = normalize_gas_url(self.endpoint_url, self.repo_path, sub_path, query_params)

        # Fast path: reuse already-verified auth strategy across chunks without re-probing
        if self._working_auth_headers is not None:
            try:
                return self._execute_with_redirects(
                    url, method, body, content_type, self._working_auth_headers
                )
            except PermissionError:
                self._working_auth_headers = None

        strategies: List[Tuple[str, Dict[str, str]]] = []
        env_headers = self.auth.get_env_auth_headers()
        if env_headers:
            strategies.append(("env", env_headers))

        strategies.append(("anonymous", {}))

        cached_headers = self.auth.load_cached_auth()
        if cached_headers:
            strategies.append(("cached", cached_headers))

        clasp_token = self.auth.get_clasp_bearer_token()
        if clasp_token:
            strategies.append(("clasp", {"Authorization": f"Bearer {clasp_token}"}))

        last_error: Optional[Exception] = None

        for _label, auth_headers in strategies:
            try:
                res = self._execute_with_redirects(url, method, body, content_type, auth_headers)
                self._working_auth_headers = auth_headers
                return res
            except PermissionError as e:
                last_error = e
                continue

        interactive_headers = self.auth.prompt_browser_login(url)
        if interactive_headers is not None:
            try:
                res = self._execute_with_redirects(url, method, body, content_type, interactive_headers)
                self._working_auth_headers = interactive_headers
                return res
            except Exception as e:
                last_error = e

        raise RuntimeError(f"Failed to access GAS Git Server ({url}): {last_error}")

    def _execute_with_redirects(
        self,
        url: str,
        method: str,
        body: Optional[bytes],
        content_type: Optional[str],
        auth_headers: Dict[str, str],
        max_redirects: int = 10,
    ) -> bytes:
        curr_url = url
        curr_method = method
        curr_body = body
        timeout_val = get_gas_git_timeout()

        for _ in range(max_redirects):
            headers = {
                "User-Agent": "git-remote-gas/0.5",
                "Accept": "*/*",
            }
            if content_type and curr_body is not None:
                headers["Content-Type"] = content_type
            parsed_curr = urllib.parse.urlparse(curr_url)
            if "googleusercontent.com" not in parsed_curr.netloc:
                headers.update(auth_headers)
            elif "Cookie" in auth_headers:
                headers["Cookie"] = auth_headers["Cookie"]

            try:
                status, reason, headers_map, raw = self.pool.request(
                    curr_url, curr_method, headers, curr_body, timeout_val
                )
            except (TimeoutError, socket.timeout, urllib.error.URLError) as e:
                is_timeout = isinstance(e, (TimeoutError, socket.timeout)) or (
                    "timed out" in str(e).lower()
                )
                if is_timeout:
                    sec_desc = f"{int(timeout_val)}s" if timeout_val else "specified limit"
                    raise RuntimeError(
                        f"Request to GAS Git Server timed out after {sec_desc} while waiting for Google Apps Script & Google Drive to process the operation.\n"
                        "To relax the timeout limit, set the GAS_GIT_TIMEOUT environment variable (e.g. `export GAS_GIT_TIMEOUT=600` for 10 minutes, or `export GAS_GIT_TIMEOUT=0` to disable timeout)."
                    )
                raise RuntimeError(f"HTTP connection error from GAS ({curr_url}): {e}")
            except Exception as e:
                raise RuntimeError(f"HTTP connection error from GAS ({curr_url}): {e}")

            if status in (301, 302, 303, 307, 308):
                location = headers_map.get("Location") or headers_map.get("location")
                if not location:
                    raise RuntimeError(f"HTTP {status} without Location header")
                next_url = urllib.parse.urljoin(curr_url, location)
                if "accounts.google.com" in next_url or "ServiceLogin" in next_url:
                    raise PermissionError(
                        f"Redirected to Google Login page ({next_url})"
                    )
                if status in (301, 302, 303):
                    curr_method = "GET"
                    curr_body = None
                curr_url = next_url
                continue

            if status in (401, 403, 404):
                raise PermissionError(f"HTTP {status}: {reason}")
            if status >= 400:
                raise RuntimeError(f"HTTP error {status} from GAS: {reason}")

            if raw.lstrip().startswith((b"<!DOCTYPE html", b"<html", b"<HTML")):
                text_preview = raw[:2048].decode("utf-8", errors="ignore")
                if "accounts.google.com" in text_preview or "ServiceLogin" in text_preview or "Google Drive" in text_preview:
                    raise PermissionError("Received Google HTML login page instead of Git response")
                if "メモリ不足" in text_preview or "Out of memory" in text_preview or "Exception" in text_preview:
                    raise MemoryError("GAS server reported Out Of Memory / Exception in HTML response")

            return self._decode_gas_payload(raw)

        raise RuntimeError("Exceeded maximum redirects while communicating with GAS")

    @staticmethod
    def _decode_gas_payload(raw: bytes) -> bytes:
        trimmed = raw.strip()
        if trimmed.startswith(b"ERR "):
            return trimmed
        if trimmed.startswith(b"GAS_GIT_B64:"):
            return base64.b64decode(trimmed[len(b"GAS_GIT_B64:") :])
        if len(raw) >= 4:
            try:
                int(raw[:4].decode("ascii"), 16)
                return raw
            except ValueError:
                pass
        try:
            decoded = base64.b64decode(trimmed, validate=True)
            if len(decoded) >= 4:
                return decoded
        except Exception:
            pass
        return raw


def parse_refs_from_advertisement(data: bytes) -> Tuple[List[Tuple[str, str]], Optional[str]]:
    """
    Parses Smart HTTP v1 pkt-line ref advertisement.
    Handles empty repositories (`0000... capabilities^{}`) without emitting a fake ref.
    """
    if data.startswith(b"ERR "):
        raise RuntimeError(data[4:].decode("utf-8", errors="replace").strip())

    idx = 0
    refs: List[Tuple[str, str]] = []
    symref_head: Optional[str] = None

    while idx + 4 <= len(data):
        pkt_len_hex = data[idx : idx + 4].decode("ascii", errors="replace")
        idx += 4
        if pkt_len_hex == "0000":
            continue
        pkt_len = int(pkt_len_hex, 16)
        if pkt_len <= 4:
            continue
        payload = data[idx : idx + pkt_len - 4]
        idx += pkt_len - 4

        if payload.startswith(b"#"):
            continue
        if payload.startswith(b"ERR "):
            raise RuntimeError(payload[4:].decode("utf-8", errors="replace").strip())

        line = payload.rstrip(b"\r\n")
        caps: List[str] = []
        if b"\x00" in line:
            ref_part, cap_part = line.split(b"\x00", 1)
            caps = cap_part.decode("utf-8", errors="replace").split()
        else:
            ref_part = line

        for c in caps:
            if c.startswith("symref=HEAD:"):
                symref_head = c.split(":", 1)[1]

        parts = ref_part.decode("utf-8", errors="replace").split(" ", 1)
        if len(parts) == 2:
            oid, refname = parts
            # Skip empty-repo capability advertisement (`0000... capabilities^{}`)
            if refname == "capabilities^{}" or oid == "0" * 40:
                continue
            refs.append((oid, refname))

    return refs, symref_head


def build_receive_pack_commands(updates: List[Tuple[str, str, str]]) -> bytes:
    """
    Encode Smart HTTP v1 `git-receive-pack` command list (`old_oid new_oid dst`) + `0000` flush-pkt.
    """
    cmds = bytearray()
    for idx, (old_oid, new_oid, dst) in enumerate(updates):
        if idx == 0:
            cmd_str = f"{old_oid} {new_oid} {dst}\x00report-status side-band-64k object-format=sha1 agent=git-remote-gas/0.5\n"
        else:
            cmd_str = f"{old_oid} {new_oid} {dst}\n"
        pkt = cmd_str.encode("utf-8")
        cmds.extend(f"{len(pkt) + 4:04x}".encode("ascii") + pkt)
    cmds.extend(b"0000")
    return bytes(cmds)


def pack_object_list(obj_lines: List[str]) -> bytes:
    """
    Run `git pack-objects --stdout --delta-base-offset -q` on an explicit list of object lines
    (`<oid>` or `<oid> <path_hint>`).
    Produces a 100% self-contained Git `PACK` v2 stream using internal `OFS_DELTA` compression
    with zero external `REF_DELTA` dependencies.
    """
    if not obj_lines:
        # Valid empty 0-object PACK v2 header + SHA-1 checksum
        header = b"PACK\x00\x00\x00\x02\x00\x00\x00\x00"
        import hashlib
        return header + hashlib.sha1(header).digest()

    stdin_bytes = ("\n".join(obj_lines) + "\n").encode("utf-8")
    proc = subprocess.run(
        [
            "git",
            "pack-objects",
            "--stdout",
            "--delta-base-offset",
            "--window=10",
            "--depth=20",
            "-q",
        ],
        input=stdin_bytes,
        capture_output=True,
        check=True,
    )
    return proc.stdout


def scan_missing_objects_with_sizes(
    include_oids: List[str], exclude_oids: Set[str]
) -> List[Tuple[str, str, int, str]]:
    """
    Returns ordered list of `(oid, obj_type, uncompressed_size, rev_line_with_hint)`
    for all objects reachable from `include_oids` and not reachable from `exclude_oids`.
    """
    if not include_oids:
        return []
    rev_cmd = ["git", "rev-list", "--objects", "--topo-order", "--reverse"]
    rev_cmd.extend(include_oids)
    for ex in exclude_oids:
        if ex and ex != "0" * 40:
            rev_cmd.append(f"^{ex}")

    rev_out = subprocess.check_output(rev_cmd, text=True)
    raw_lines = [l for l in rev_out.splitlines() if l.strip()]
    if not raw_lines:
        return []

    oid_list: List[str] = []
    hint_by_oid: Dict[str, str] = {}
    for line in raw_lines:
        parts = line.split(" ", 1)
        oid = parts[0]
        if oid not in hint_by_oid:
            oid_list.append(oid)
            hint_by_oid[oid] = line

    cat_proc = subprocess.run(
        ["git", "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
        input="\n".join(oid_list) + "\n",
        capture_output=True,
        text=True,
        check=True,
    )

    result: List[Tuple[str, str, int, str]] = []
    for line in cat_proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3:
            oid, otype, osize_str = parts[0], parts[1], parts[2]
            try:
                osize = int(osize_str)
            except ValueError:
                osize = 0
            result.append((oid, otype, osize, hint_by_oid.get(oid, oid)))
    return result


def partition_objects_into_chunks(
    objects: List[Tuple[str, str, int, str]],
    max_objs: int,
    max_uncompressed_bytes: int,
) -> List[Tuple[List[str], int]]:
    """
    Splits `objects` into chunks where each chunk has `<= max_objs` objects and
    `<= max_uncompressed_bytes` total uncompressed bytes.
    Returns list of `(rev_lines_with_hints, chunk_uncompressed_bytes)`.
    """
    chunks: List[Tuple[List[str], int]] = []
    curr_lines: List[str] = []
    curr_bytes = 0

    for _oid, _otype, osize, rev_line in objects:
        if curr_lines and (
            len(curr_lines) >= max_objs or curr_bytes + osize > max_uncompressed_bytes
        ):
            chunks.append((curr_lines, curr_bytes))
            curr_lines = []
            curr_bytes = 0
        curr_lines.append(rev_line)
        curr_bytes += osize

    if curr_lines:
        chunks.append((curr_lines, curr_bytes))

    return chunks


def send_receive_pack_payload(
    client: GasHttpClient,
    updates: List[Tuple[str, str, str]],
    pack_data: bytes,
) -> str:
    """
    Sends a single Smart HTTP v1 `POST /<repo>.git/git-receive-pack` request.
    """
    full_payload = build_receive_pack_commands(updates) + pack_data
    envelope = json.dumps(
        {
            "service": "git-receive-pack",
            "git_path": client.full_git_path("/git-receive-pack"),
            "encoding": "base64",
            "body_base64": base64.b64encode(full_payload).decode("ascii"),
        }
    ).encode("utf-8")

    resp = client.request(
        "POST",
        "/git-receive-pack",
        {"service": "git-receive-pack", "encoding": "base64"},
        body=envelope,
        content_type="application/json",
    )
    text_resp = resp.decode("utf-8", errors="replace")
    if "ERR " in text_resp:
        raise RuntimeError(text_resp.strip())
    if "unpack " in text_resp and "unpack ok" not in text_resp:
        raise RuntimeError(f"Remote unpack failed: {text_resp.strip()}")
    for _old_oid, _new_oid, dst in updates:
        ng_marker = f"ng {dst} "
        if ng_marker in text_resp:
            reason = text_resp.split(ng_marker, 1)[1].splitlines()[0]
            raise RuntimeError(f"ng {dst} {reason}")
    return text_resp


def send_object_chunk_with_adaptive_split(
    client: GasHttpClient,
    rev_lines: List[str],
    updates: List[Tuple[str, str, str]],
    noop_updates: List[Tuple[str, str, str]],
    max_pack_bytes: int,
    prebuilt_pack: Optional[bytes] = None,
) -> str:
    """
    Sends `rev_lines` + `updates` in a Smart HTTP v1 `git-receive-pack` call.
    If the packed size exceeds `max_pack_bytes` or GAS reports an OOM / HTTP 500 error,
    automatically splits `rev_lines` in half, sends the first half with `noop_updates`,
    and sends the second half with `updates`.
    """
    pack_data = prebuilt_pack if prebuilt_pack is not None else pack_object_list(rev_lines)

    if len(pack_data) > max_pack_bytes and len(rev_lines) > 1:
        mid = len(rev_lines) // 2
        send_object_chunk_with_adaptive_split(
            client, rev_lines[:mid], noop_updates, noop_updates, max_pack_bytes
        )
        return send_object_chunk_with_adaptive_split(
            client, rev_lines[mid:], updates, noop_updates, max_pack_bytes
        )

    try:
        return send_receive_pack_payload(client, updates, pack_data)
    except (MemoryError, RuntimeError) as err:
        err_str = str(err)
        is_non_ff = "non-fast-forward" in err_str or "invalid refname" in err_str
        if is_non_ff or len(rev_lines) <= 1:
            raise
        log_err(
            f"Chunk of {len(rev_lines)} objects ({len(pack_data) / 1024:.1f} KB) hit server limit; splitting in half and retrying..."
        )
        mid = len(rev_lines) // 2
        send_object_chunk_with_adaptive_split(
            client, rev_lines[:mid], noop_updates, noop_updates, max_pack_bytes
        )
        return send_object_chunk_with_adaptive_split(
            client, rev_lines[mid:], updates, noop_updates, max_pack_bytes
        )


def execute_push(
    client: GasHttpClient,
    specs: List[str],
    remote_map: Dict[str, str],
) -> List[Tuple[str, Optional[str]]]:
    """
    Executes a Smart HTTP v1 push for `specs`.
    - Uses single-request fast path when objects and uncompressed size fit within 1 chunk.
    - Automatically switches to pipelined multi-chunk commit-checkpoint push for large repositories.
    Returns list of `(dst_ref, error_reason_or_none)`.
    """
    max_objs, max_uncomp, max_pack, max_commits = get_chunk_limits()
    known_remote_oids: Set[str] = {
        oid for oid in remote_map.values() if oid and oid != "0" * 40
    }

    parsed_specs: List[Tuple[str, str, str]] = []
    deletions: List[Tuple[str, str, str]] = []
    updates: List[Tuple[str, str, str]] = []

    for spec in specs:
        force = spec.startswith("+")
        clean_spec = spec[1:] if force else spec
        src, dst = clean_spec.split(":", 1)
        old_oid = remote_map.get(dst, "0" * 40)
        if src == "":
            new_oid = "0" * 40
            deletions.append((old_oid, new_oid, dst))
        else:
            new_oid = subprocess.check_output(["git", "rev-parse", src], text=True).strip()
            updates.append((old_oid, new_oid, dst))
        parsed_specs.append((old_oid, new_oid, dst))

    if not updates:
        # Pure ref deletion(s)
        empty_pack = pack_object_list([])
        try:
            send_receive_pack_payload(client, deletions, empty_pack)
            return [(dst, None) for _, _, dst in parsed_specs]
        except Exception as e:
            return [(dst, str(e)) for _, _, dst in parsed_specs]

    # Scan total missing objects across all updates
    target_new_oids = [new_oid for _, new_oid, _ in updates]
    all_missing = scan_missing_objects_with_sizes(target_new_oids, known_remote_oids)
    total_objs = len(all_missing)
    total_uncomp = sum(item[2] for item in all_missing)

    # FAST PATH: fits within a single chunk budget -> send in 1 single HTTP request!
    if total_objs <= max_objs and total_uncomp <= max_uncomp:
        rev_args: List[str] = list(target_new_oids)
        for ex in known_remote_oids:
            rev_args.append(f"^{ex}")
        pack_proc = subprocess.run(
            ["git", "pack-objects", "--stdout", "--revs", "--delta-base-offset", "-q"],
            input=("\n".join(rev_args) + "\n").encode("utf-8"),
            capture_output=True,
            check=True,
        )
        pack_data = pack_proc.stdout
        if len(pack_data) <= max_pack:
            try:
                send_receive_pack_payload(client, parsed_specs, pack_data)
                return [(dst, None) for _, _, dst in parsed_specs]
            except MemoryError:
                # Fall through to multi-chunk path if server reported OOM
                pass
            except Exception as e:
                err_msg = str(e)
                if "メモリ不足" not in err_msg and "Out of memory" not in err_msg:
                    return [(dst, err_msg) for _, _, dst in parsed_specs]

    # MULTI-CHUNK PATH: Partition along first-parent commit checkpoints & bounded object chunks
    log_err(
        f"Large push detected ({total_objs:,} objects, {total_uncomp / (1024 * 1024):.2f} MB uncompressed). "
        f"Using Smart HTTP v1 chunked transfer (max {max_objs:,} objects / {max_uncomp / (1024 * 1024):.1f} MB raw per chunk)..."
    )

    results_out: List[Tuple[str, Optional[str]]] = []

    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
        for old_oid, new_oid, dst in updates:
            curr_remote_oid = old_oid
            try:
                # Find first-parent commit chain from curr_remote_oid -> new_oid for resumable ref checkpoints
                fp_cmd = ["git", "rev-list", "--first-parent", "--reverse", new_oid]
                for ex in known_remote_oids:
                    fp_cmd.append(f"^{ex}")
                fp_commits = [
                    c.strip()
                    for c in subprocess.check_output(fp_cmd, text=True).splitlines()
                    if c.strip()
                ]
                if not fp_commits or fp_commits[-1] != new_oid:
                    fp_commits.append(new_oid)

                # Group first-parent commits into checkpoint windows of up to `max_commits`
                checkpoints: List[str] = []
                for idx in range(max_commits - 1, len(fp_commits), max_commits):
                    checkpoints.append(fp_commits[idx])
                if not checkpoints or checkpoints[-1] != new_oid:
                    checkpoints.append(new_oid)

                # Build the sequence of object chunks across all checkpoints
                # Each planned item is: (rev_lines, raw_bytes, is_checkpoint_end, target_checkpoint_oid)
                planned_chunks: List[Tuple[List[str], int, bool, str]] = []
                simulated_known = set(known_remote_oids)

                for cp_oid in checkpoints:
                    cp_objects = scan_missing_objects_with_sizes([cp_oid], simulated_known)
                    if not cp_objects:
                        if cp_oid == new_oid and curr_remote_oid != new_oid:
                            planned_chunks.append(([], 0, True, cp_oid))
                        simulated_known.add(cp_oid)
                        continue

                    sub_chunks = partition_objects_into_chunks(cp_objects, max_objs, max_uncomp)
                    for sc_idx, (sc_lines, sc_bytes) in enumerate(sub_chunks):
                        is_last_sub = sc_idx == len(sub_chunks) - 1
                        planned_chunks.append((sc_lines, sc_bytes, is_last_sub, cp_oid))
                    simulated_known.add(cp_oid)

                total_chunks = len(planned_chunks)
                if total_chunks == 0:
                    send_receive_pack_payload(
                        client, [(curr_remote_oid, new_oid, dst)], pack_object_list([])
                    )
                    results_out.append((dst, None))
                    continue

                # Pipeline `pack_object_list` of chunk i+1 while chunk i is uploading over HTTP
                next_pack_future: Optional[concurrent.futures.Future[bytes]] = executor.submit(
                    pack_object_list, planned_chunks[0][0]
                )

                for chunk_idx, (sc_lines, sc_bytes, is_cp_end, cp_oid) in enumerate(planned_chunks):
                    assert next_pack_future is not None
                    pack_bytes = next_pack_future.result()

                    if chunk_idx + 1 < total_chunks:
                        next_pack_future = executor.submit(
                            pack_object_list, planned_chunks[chunk_idx + 1][0]
                        )
                    else:
                        next_pack_future = None

                    noop_cmd = [(curr_remote_oid, curr_remote_oid, dst)]
                    if is_cp_end:
                        step_cmd = [(curr_remote_oid, cp_oid, dst)]
                    else:
                        step_cmd = noop_cmd

                    t_start = time.time()
                    send_object_chunk_with_adaptive_split(
                        client,
                        sc_lines,
                        step_cmd,
                        noop_cmd,
                        max_pack,
                        prebuilt_pack=pack_bytes,
                    )
                    elapsed = time.time() - t_start

                    if is_cp_end:
                        curr_remote_oid = cp_oid
                        known_remote_oids.add(cp_oid)

                    log_err(
                        f"  Chunk {chunk_idx + 1}/{total_chunks}: {len(sc_lines):,} objects "
                        f"({len(pack_bytes) / 1024:.1f} KB pack / {sc_bytes / (1024 * 1024):.2f} MB raw) "
                        f"in {elapsed:.2f}s -> {curr_remote_oid[:7]}"
                    )

                results_out.append((dst, None))
            except Exception as e:
                log_err(f"Error pushing {dst}: {e}")
                results_out.append((dst, str(e)))

    if deletions:
        try:
            send_receive_pack_payload(client, deletions, pack_object_list([]))
            for _, _, dst in deletions:
                results_out.append((dst, None))
        except Exception as e:
            for _, _, dst in deletions:
                results_out.append((dst, str(e)))

    return results_out


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "--save-token":
        auth = GasAuthManager("")
        auth.save_cached_auth(token=sys.argv[2].strip())
        print(f"Saved token to {AUTH_CACHE_PATH}")
        return 0

    if len(sys.argv) < 3:
        log_err("Usage: git-remote-gas <remote-name> <url>")
        return 1

    raw_url = sys.argv[2]
    try:
        client = GasHttpClient(raw_url)
    except ValueError as e:
        log_err(str(e))
        return 1

    cached_refs: Optional[Tuple[List[Tuple[str, str]], Optional[str]]] = None

    def get_refs(for_push: bool = False) -> Tuple[List[Tuple[str, str]], Optional[str]]:
        nonlocal cached_refs
        if cached_refs is not None and not for_push:
            return cached_refs
        service = "git-receive-pack" if for_push else "git-upload-pack"
        adv = client.request("GET", "/info/refs", {"service": service})
        parsed = parse_refs_from_advertisement(adv)
        if not for_push:
            cached_refs = parsed
        return parsed

    while True:
        line = sys.stdin.readline()
        if not line:
            break
        line = line.rstrip("\r\n")

        if line == "capabilities":
            sys.stdout.write("fetch\npush\n\n")
            sys.stdout.flush()

        elif line.startswith("list"):
            for_push = "for-push" in line
            try:
                refs, symref_head = get_refs(for_push=for_push)
            except Exception as e:
                log_err(str(e))
                return 1

            if symref_head and refs:
                sys.stdout.write(f"@{symref_head} HEAD\n")
            for oid, refname in refs:
                sys.stdout.write(f"{oid} {refname}\n")
            sys.stdout.write("\n")
            sys.stdout.flush()

        elif line.startswith("fetch "):
            wants: List[str] = []
            while line.startswith("fetch "):
                parts = line.split()
                if len(parts) >= 2:
                    wants.append(parts[1])
                line = sys.stdin.readline().rstrip("\r\n")

            req_lines = bytearray()
            for oid in wants:
                pkt = f"want {oid}\n".encode("ascii")
                req_lines.extend(f"{len(pkt) + 4:04x}".encode("ascii") + pkt)
            req_lines.extend(b"00000009done\n")

            envelope = json.dumps(
                {
                    "service": "git-upload-pack",
                    "git_path": client.full_git_path("/git-upload-pack"),
                    "encoding": "base64",
                    "body_base64": base64.b64encode(bytes(req_lines)).decode("ascii"),
                }
            ).encode("utf-8")

            resp = client.request(
                "POST",
                "/git-upload-pack",
                {"service": "git-upload-pack", "encoding": "base64"},
                body=envelope,
                content_type="application/json",
            )
            pack_idx = resp.find(b"PACK")
            if pack_idx == -1:
                raise RuntimeError(
                    f"No PACK signature found in upload-pack response: {resp[:200]!r}"
                )
            pack_data = resp[pack_idx:]
            if pack_data.endswith(b"0000"):
                pack_data = pack_data[:-4]
            proc = subprocess.run(
                ["git", "index-pack", "--stdin", "--fix-thin"],
                input=pack_data,
                stdout=subprocess.DEVNULL,
                check=False,
            )
            if proc.returncode != 0:
                return proc.returncode
            sys.stdout.write("\n")
            sys.stdout.flush()

        elif line.startswith("push "):
            specs: List[str] = []
            while line.startswith("push "):
                specs.append(line[len("push ") :])
                line = sys.stdin.readline().rstrip("\r\n")

            try:
                refs, _ = get_refs(for_push=True)
            except Exception as e:
                log_err(str(e))
                return 1
            remote_map = {refname: oid for oid, refname in refs}

            push_outcomes = execute_push(client, specs, remote_map)
            for dst, err_reason in push_outcomes:
                if err_reason is None:
                    sys.stdout.write(f"ok {dst}\n")
                else:
                    clean_reason = err_reason.splitlines()[0] if err_reason else "push failed"
                    sys.stdout.write(f"error {dst} {clean_reason}\n")
            sys.stdout.write("\n")
            sys.stdout.flush()

        elif line == "":
            break

    return 0


if __name__ == "__main__":
    sys.exit(main())
